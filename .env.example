# Copie para .env (ignorado pelo git) ou defina no Cloud Environment.
# NUNCA coloque valores reais neste arquivo nem no chat.

# --- Cloudflare (API) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_TOKEN=

# --- Cloudflare R2 (credenciais S3-compatíveis) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com

# --- Programa EXECUTAR ---
EXECUTAR_URL=
EXECUTAR_AGENT_TOKEN=
