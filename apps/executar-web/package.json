{
  "name": "executar-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EXECUTAR · landing do produto, app Prisma (PWA mobile), modelos A4 e API Next.js + Prisma ORM.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@executar/core": "*",
    "@phosphor-icons/web": "2.1.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "next": "16.4.2",
    "server-only": "0.0.1",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "dotenv": "18.0.8",
    "eslint": "9.39.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "globals": "16.5.0",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vitest": "4.1.10"
  }
}
