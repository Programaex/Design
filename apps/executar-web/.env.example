# Postgres usado pelo Prisma ORM (rotas /api/*).
DATABASE_URL="postgresql://executar:executar@localhost:5432/executar"
# Segredo HMAC do cookie de sessão (32+ caracteres aleatórios). Obrigatório em produção.
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio"
# Em desenvolvimento o link de acesso volta na resposta de /api/auth/email.
# Em produção só ative se não houver envio de e-mail configurado e o ambiente for fechado.
AUTH_DEV_LINKS="1"
