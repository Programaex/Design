{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Mesmo nome do Worker publicado em design.bus-programa.workers.dev.
	"name": "design",
	"main": "worker/index.js",
	"compatibility_date": "2025-10-08",
	"workers_dev": true,
	// dist/ é gerado por build.mjs. O Worker roda antes dos assets para exigir login (CMS).
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"not_found_handling": "404-page"
	},
	"kv_namespaces": [{ "binding": "CMS_KV", "id": "544a27ed6dc743d99f155184dfe65292" }],
	// Secrets (wrangler secret put): CMS_USER, CMS_PASS, SESSION_SECRET, CF_ANALYTICS_TOKEN, CF_ACCOUNT_ID.
	"vars": { "CF_SCRIPT_NAME": "design" },
	"observability": { "enabled": true }
}
