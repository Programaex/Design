{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://executar.example/schemas/network.schema.json",
  "title": "BrainNetworkDocument",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "demo",
    "workspace",
    "people",
    "relations",
    "layers"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "demo": {
      "type": "boolean"
    },
    "workspace": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "people": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/person"
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relation"
      }
    },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "visibilityDefault": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "role",
        "layerId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "layerId": {
          "type": "string"
        },
        "teamId": {
          "type": [
            "string",
            "null"
          ]
        },
        "avatarUri": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to",
        "kind",
        "status",
        "provenance"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "affiliation",
            "matching",
            "responsibility"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "verified",
            "rejected"
          ]
        },
        "directed": {
          "type": "boolean"
        },
        "provenance": {
          "type": "string"
        }
      }
    }
  }
}