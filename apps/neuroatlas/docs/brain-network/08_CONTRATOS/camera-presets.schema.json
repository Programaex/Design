{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CameraPresets",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "yawDegrees",
      "pitchDegrees",
      "description"
    ],
    "properties": {
      "id": {
        "type": "string"
      },
      "name": {
        "type": "string"
      },
      "yawDegrees": {
        "type": "number",
        "minimum": 0,
        "maximum": 360
      },
      "pitchDegrees": {
        "type": "number",
        "minimum": -85,
        "maximum": 85
      },
      "description": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}