{
  "name": "@executar/gestao",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && wrangler dev",
    "deploy": "node build.mjs && wrangler deploy",
    "snapshot": "node scripts/snapshot.mjs --workbook ../../../workbook",
    "pdf": "node build.mjs && node scripts/pdf.mjs",
    "test": "vitest run && node --test test/*.node.test.mjs",
    "deploy:inline": "node build.mjs && node scripts/build-inline-assets.mjs && wrangler deploy -c wrangler.inline.jsonc"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.3",
    "esbuild": "0.28.1",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vitest": "4.1.10",
    "wrangler": "4.136.1"
  }
}
