{
  "name": "executar-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "EXECUTAR · Prisma nativo (iOS e Android) com Expo Router. Mesmo domínio (@executar/core) e mesma API do app web.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "build": "expo export --platform android --platform ios --output-dir dist"
  },
  "dependencies": {
    "@executar/core": "*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.12",
    "expo-constants": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-haptics": "~58.0.6",
    "expo-linking": "~58.0.13",
    "expo-notifications": "~58.1.4",
    "expo-print": "~58.0.6",
    "expo-router": "~58.0.21",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.18",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "phosphor-react-native": "3.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
